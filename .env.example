# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role key — server-side only, NEVER exposed to the browser.
# Used by the scraper (app/api/cron/scrape) to write new articles/images.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Shared secret so only Vercel Cron (or you) can trigger the scraper.
# Generate any random string, e.g.: openssl rand -hex 24
CRON_SECRET=change-me
